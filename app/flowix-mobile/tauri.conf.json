{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flowix Mobile",
  "version": "1.5.6",
  "identifier": "com.flowix.app.mobile",
  "build": {
    "beforeBuildCommand": "npm run build:mobile",
    "frontendDist": "../../.build/web-mobile-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Flowix",
        "width": 400,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "../flowix-desktop/icons/32x32.png",
      "../flowix-desktop/icons/128x128.png",
      "../flowix-desktop/icons/128x128@2x.png",
      "../flowix-desktop/icons/icon.ico"
    ]
  }
}
